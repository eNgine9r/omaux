#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omaux"
STATE="$STATE_DIR/minimized.json"
mkdir -p "$STATE_DIR"
[[ -f "$STATE" ]] || printf '%s\n' '{"version":1,"windows":{}}' >"$STATE"

normalize() {
  printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | sed -E 's/\.desktop$//; s/[^a-z0-9]+//g'
}

clients() { hyprctl clients -j 2>/dev/null || printf '[]'; }
active() { hyprctl activewindow -j 2>/dev/null || printf '{}'; }

atomic_state() {
  local tmp
  tmp=$(mktemp "$STATE_DIR/.minimized.XXXXXX")
  cat >"$tmp"
  if [[ -f "$STATE" ]] && cmp -s "$tmp" "$STATE"; then
    rm -f "$tmp"
    return 0
  fi
  mv "$tmp" "$STATE"
}

prune() {
  local live next
  live=$(clients | jq -c 'map({key:.address,value:{workspace:(.workspace.name // ""),stableId:(.stableId // ""),pid:(.pid // 0),initialTitle:(.initialTitle // "")}}) | from_entries')
  next=$(jq -c --argjson live "$live" '
    .windows |= with_entries(
      .key as $k | .value as $saved | ($live[$k] // null) as $now |
      select($now != null and $now.workspace == "special:minimized") |
      select(
        if ($saved.stableId // "") != "" then
          $saved.stableId == $now.stableId
        else
          (($saved.pid // 0) == 0 or ($saved.pid == $now.pid)) and
          (($saved.initialTitle // "") == "" or ($saved.initialTitle == $now.initialTitle))
        end
      )
    )
  ' "$STATE")
  printf '%s\n' "$next" | atomic_state
}

client_key_json() {
  local json="$1" cls initial
  cls=$(jq -r '.class // ""' <<<"$json")
  initial=$(jq -r '.initialClass // ""' <<<"$json")
  cls=$(normalize "$cls")
  [[ -n "$cls" ]] && { printf '%s' "$cls"; return; }
  normalize "$initial"
}

move_window() {
  local addr="$1" workspace="$2"
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$workspace\", follow = false, window = \"address:$addr\" })" >/dev/null
}

focus_window() {
  local addr="$1"
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
}

minimize_address() {
  local addr="$1" c ws key title stable_id pid initial_title next actual
  c=$(clients | jq -c --arg a "$addr" 'first(.[] | select(.address == $a)) // empty')
  [[ -n "$c" ]] || return 1
  ws=$(jq -r '.workspace.name // ""' <<<"$c")
  [[ -n "$ws" && "$ws" != "special:minimized" ]] || return 0
  key=$(client_key_json "$c")
  title=$(jq -r '.title // ""' <<<"$c")
  stable_id=$(jq -r '.stableId // ""' <<<"$c")
  pid=$(jq -r '.pid // 0' <<<"$c")
  initial_title=$(jq -r '.initialTitle // ""' <<<"$c")
  move_window "$addr" "special:minimized"
  sleep 0.08
  actual=$(clients | jq -r --arg a "$addr" 'first(.[] | select(.address == $a)) | .workspace.name // ""')
  [[ "$actual" == "special:minimized" ]] || return 1
  next=$(jq -c --arg a "$addr" --arg ws "$ws" --arg key "$key" --arg title "$title" \
    --arg stableId "$stable_id" --argjson pid "$pid" --arg initialTitle "$initial_title" \
    '.windows[$a] = {workspace:$ws, appKey:$key, title:$title, stableId:$stableId, pid:$pid, initialTitle:$initialTitle}' "$STATE")
  printf '%s\n' "$next" | atomic_state
}

restore_address() {
  local addr="$1" ws next exists current actual
  exists=$(clients | jq -r --arg a "$addr" 'any(.[]; .address == $a)')
  if [[ "$exists" != true ]]; then
    next=$(jq -c --arg a "$addr" 'del(.windows[$a])' "$STATE")
    printf '%s\n' "$next" | atomic_state
    return 1
  fi

  current=$(clients | jq -r --arg a "$addr" 'first(.[] | select(.address == $a)) | .workspace.name // ""')
  if [[ "$current" != "special:minimized" ]]; then
    next=$(jq -c --arg a "$addr" 'del(.windows[$a])' "$STATE")
    printf '%s\n' "$next" | atomic_state
    focus_window "$addr"
    return 0
  fi

  ws=$(jq -r --arg a "$addr" '.windows[$a].workspace // empty' "$STATE")
  [[ -n "$ws" ]] || ws=$(hyprctl activeworkspace -j | jq -r '.name // "1"')
  [[ "$ws" != special:* ]] || ws=$(hyprctl activeworkspace -j | jq -r '.name // "1"')

  move_window "$addr" "$ws"
  sleep 0.08
  actual=$(clients | jq -r --arg a "$addr" 'first(.[] | select(.address == $a)) | .workspace.name // ""')
  if [[ "$actual" == "special:minimized" ]]; then
    move_window "$addr" "$ws"
    sleep 0.08
    actual=$(clients | jq -r --arg a "$addr" 'first(.[] | select(.address == $a)) | .workspace.name // ""')
  fi
  [[ "$actual" != "special:minimized" && -n "$actual" ]] || return 1

  focus_window "$addr"
  next=$(jq -c --arg a "$addr" 'del(.windows[$a])' "$STATE")
  printf '%s\n' "$next" | atomic_state
}

activate_address() {
  local addr="$1" current
  current=$(clients | jq -r --arg a "$addr" 'first(.[] | select(.address == $a)) | .workspace.name // ""')
  [[ -n "$current" ]] || return 1
  if [[ "$current" == "special:minimized" ]]; then
    restore_address "$addr"
  else
    focus_window "$addr"
  fi
}

find_visible_for_key() {
  local wanted="$1" c key ws hist addr best="" best_hist=999999
  while IFS= read -r c; do
    key=$(client_key_json "$c")
    ws=$(jq -r '.workspace.name // ""' <<<"$c")
    if [[ "$key" == "$wanted" && "$ws" != "special:minimized" ]]; then
      hist=$(jq -r '.focusHistoryID // 999999' <<<"$c")
      addr=$(jq -r '.address // empty' <<<"$c")
      if [[ -n "$addr" && "$hist" =~ ^[0-9]+$ && "$hist" -lt "$best_hist" ]]; then
        best="$addr"
        best_hist="$hist"
      fi
    fi
  done < <(clients | jq -c '.[]')
  [[ -n "$best" ]] || return 1
  printf '%s
' "$best"
}

find_minimized_for_key() {
  local wanted="$1" c key ws hist addr best="" best_hist=999999
  while IFS= read -r c; do
    key=$(client_key_json "$c")
    ws=$(jq -r '.workspace.name // ""' <<<"$c")
    if [[ "$key" == "$wanted" && "$ws" == "special:minimized" ]]; then
      hist=$(jq -r '.focusHistoryID // 999999' <<<"$c")
      addr=$(jq -r '.address // empty' <<<"$c")
      if [[ -n "$addr" && "$hist" =~ ^[0-9]+$ && "$hist" -lt "$best_hist" ]]; then
        best="$addr"
        best_hist="$hist"
      fi
    fi
  done < <(clients | jq -c '.[]')
  [[ -n "$best" ]] || return 1
  printf '%s
' "$best"
}

launch_desktop() {
  local desktop="${1:-}"
  [[ -n "$desktop" ]] || return 1
  desktop=${desktop%.desktop}
  systemd-run --user --quiet --collect --unit="omaux-launch-$(date +%s%N)" \
    uwsm-app -- gtk-launch "$desktop.desktop" >/dev/null 2>&1 || \
    uwsm-app -- gtk-launch "$desktop.desktop" >/dev/null 2>&1 &
}

click_app() {
  local wanted="$1" desktop="${2:-}" visible minimized
  prune

  # macOS-style Dock semantics: clicking a running app activates it; it never
  # toggles minimize. Minimize is an explicit window action (yellow button or
  # shortcut), while exact window selection lives in the hover previews.
  visible=$(find_visible_for_key "$wanted" || true)
  if [[ -n "$visible" ]]; then
    focus_window "$visible"
    return
  fi

  # If every window of the app is minimized, restore one so an app-icon click
  # still behaves like app activation rather than silently doing nothing.
  minimized=$(find_minimized_for_key "$wanted" || true)
  if [[ -n "$minimized" ]]; then
    restore_address "$minimized"
    return
  fi

  launch_desktop "$desktop"
}

case "${1:-}" in
  minimize-active)
    prune
    addr=$(active | jq -r '.address // empty')
    [[ -n "$addr" ]] && minimize_address "$addr"
    ;;
  restore)
    prune
    restore_address "${2:?address required}"
    ;;
  activate)
    prune
    activate_address "${2:?address required}"
    ;;
  restore-app)
    prune
    addr=$(find_minimized_for_key "${2:?app key required}" || true)
    [[ -n "$addr" ]] && restore_address "$addr"
    ;;
  click)
    click_app "${2:?app key required}" "${3:-}"
    ;;
  launch)
    launch_desktop "${2:?desktop id required}"
    ;;
  prune)
    prune
    ;;
  state)
    prune
    cat "$STATE"
    ;;
  *)
    echo "Usage: omaux-dock-window {minimize-active|restore <address>|activate <address>|restore-app <key>|click <key> [desktop]|launch <desktop>|prune|state}" >&2
    exit 2
    ;;
esac
